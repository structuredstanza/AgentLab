# Docker deployment settings (copy this file to .env)
# ARTEX_TAG is the tag of the image ghcr.io/jiwoochris/artex-global used by docker-compose.
# latest points to the most recent release; write a v* tag to pin a specific release.
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill in one or both, or leave empty and configure later in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# First-run protection (prevents remote takeover of the admin account)
# - The web/API port is published only on the host's 127.0.0.1 by default. To reach it from
#   another machine, set ARTEX_BIND=0.0.0.0, but finish the initial setup first.
# - On first start, a random setup token is printed to the log (docker compose logs artex),
#   and you must enter it on the /setup page to create the admin password.
#   If ARTEX_SETUP_TOKEN is set, that value is the token and nothing is printed to the log.
# - If ARTEX_ADMIN_PASSWORD is set, initialization happens immediately with that value (8+ characters), skipping /setup.
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# Browser cross-origin (CORS) allowlist, comma-separated. The built-in UI is same-origin, so leave this empty.
ARTEX_CORS_ORIGINS=
