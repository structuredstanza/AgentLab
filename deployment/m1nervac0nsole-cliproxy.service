# Rendered by ./lab: each ROOT placeholder becomes the checkout's absolute path.
[Unit]
Description=AgentLab native provider proxy (CLIProxyAPI host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/dist
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin HOME="@ROOT@/proxy-state/home" LANG=C.UTF-8 /usr/bin/strace -ff -ttt -T -yy -s256 -A -e trace=process,file,network -o "@ROOT@/proxy-state/network/proxy" "@ROOT@/dist/provider-proxy" -listen 127.0.0.1:8788 -data "@ROOT@/proxy-state" -token-file "@ROOT@/secrets/native-proxy-token"
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
KillMode=control-group

[Install]
WantedBy=default.target
