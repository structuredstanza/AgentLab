[Unit]
Description=AgentLab native provider proxy (CLIProxyAPI host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/Research/AgentLab/dist
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/mnt/Research/AgentLab/proxy-state/home LANG=C.UTF-8 /usr/bin/strace -ff -ttt -T -yy -s256 -A -e trace=process,file,network -o /mnt/Research/AgentLab/proxy-state/network/proxy /mnt/Research/AgentLab/dist/provider-proxy -listen 127.0.0.1:8788 -data /mnt/Research/AgentLab/proxy-state -token-file /mnt/Research/AgentLab/secrets/native-proxy-token
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
KillMode=control-group

[Install]
WantedBy=default.target
