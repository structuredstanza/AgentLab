diff --git a/sdk/httptransport/outbound_policy.go b/sdk/httptransport/outbound_policy.go
new file mode 100644
index 0000000..f1f6ea1
--- /dev/null
+++ b/sdk/httptransport/outbound_policy.go
@@ -0,0 +1,106 @@
+package httptransport
+
+import (
+	"errors"
+	"net/http"
+	"sync"
+)
+
+// outboundPolicy is process-owned. It is installed once, before any enabled
+// network producer builds a client, and every enabled client wraps its final
+// selected transport with it. Redirects re-enter the policy because the policy
+// wrapper is the client's transport.
+var outboundPolicy struct {
+	mu     sync.RWMutex
+	policy func(http.RoundTripper) http.RoundTripper
+}
+
+// SetOutboundPolicy installs the process-wide outbound policy. It may be
+// installed only once; a second install is an error so an active policy can
+// never be silently replaced.
+func SetOutboundPolicy(policy func(http.RoundTripper) http.RoundTripper) error {
+	if policy == nil {
+		return errors.New("httptransport: outbound policy is nil")
+	}
+	outboundPolicy.mu.Lock()
+	defer outboundPolicy.mu.Unlock()
+	if outboundPolicy.policy != nil {
+		return errors.New("httptransport: outbound policy is already installed")
+	}
+	outboundPolicy.policy = policy
+	return nil
+}
+
+// OutboundPolicyInstalled reports whether SetOutboundPolicy has installed a policy.
+func OutboundPolicyInstalled() bool {
+	outboundPolicy.mu.RLock()
+	defer outboundPolicy.mu.RUnlock()
+	return outboundPolicy.policy != nil
+}
+
+// outboundPolicyTransport marks a client whose final transport is already
+// policy-wrapped. base is the transport selected before wrapping and is nil when
+// the client used the implicit default transport. next is the transport the
+// policy wraps; it receives CloseIdleConnections so pool lifecycle is preserved.
+type outboundPolicyTransport struct {
+	base    http.RoundTripper
+	next    http.RoundTripper
+	wrapped http.RoundTripper
+}
+
+func (t *outboundPolicyTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	return t.wrapped.RoundTrip(req)
+}
+
+func (t *outboundPolicyTransport) CloseIdleConnections() {
+	if c, ok := t.next.(interface{ CloseIdleConnections() }); ok {
+		c.CloseIdleConnections()
+	}
+}
+
+// ApplyOutboundPolicy returns a copy of client whose transport is wrapped by the
+// installed policy. With no policy installed it returns client unchanged. An
+// already-wrapped client is returned as is, so the policy runs once per request.
+func ApplyOutboundPolicy(client *http.Client) *http.Client {
+	if client == nil {
+		return nil
+	}
+	outboundPolicy.mu.RLock()
+	policy := outboundPolicy.policy
+	outboundPolicy.mu.RUnlock()
+	if policy == nil {
+		return client
+	}
+	if _, ok := client.Transport.(*outboundPolicyTransport); ok {
+		return client
+	}
+	next := client.Transport
+	if next == nil {
+		next = http.DefaultTransport
+	}
+	wrapped := policy(next)
+	if wrapped == nil {
+		// Fail closed: a policy that yields no transport must not let requests through.
+		wrapped = errTransport{errors.New("httptransport: outbound policy returned a nil transport")}
+	}
+	clone := *client
+	clone.Transport = &outboundPolicyTransport{base: client.Transport, next: next, wrapped: wrapped}
+	return &clone
+}
+
+// UnwrapOutboundPolicy returns the transport a client selected before the
+// outbound policy was applied, or rt itself when rt is not policy-wrapped. It
+// returns nil when the client used the implicit default transport, so callers
+// that replace the transport keep their nil-transport handling.
+func UnwrapOutboundPolicy(rt http.RoundTripper) http.RoundTripper {
+	if t, ok := rt.(*outboundPolicyTransport); ok {
+		return t.base
+	}
+	return rt
+}
+
+type errTransport struct{ err error }
+
+func (t errTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, t.err
+}
diff --git a/sdk/httptransport/outbound_policy_test.go b/sdk/httptransport/outbound_policy_test.go
new file mode 100644
index 0000000..0befa63
--- /dev/null
+++ b/sdk/httptransport/outbound_policy_test.go
@@ -0,0 +1,157 @@
+package httptransport
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+)
+
+var errPolicyRejected = errors.New("rejected by outbound policy")
+
+type recordingTransport struct {
+	calls int
+}
+
+func (r *recordingTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	r.calls++
+	return &http.Response{StatusCode: http.StatusOK, Body: http.NoBody, Header: http.Header{}}, nil
+}
+
+type rejectingPolicyTransport struct {
+	next http.RoundTripper
+}
+
+func (p rejectingPolicyTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Header.Get("X-Blocked") != "" {
+		return nil, errPolicyRejected
+	}
+	return p.next.RoundTrip(req)
+}
+
+func resetOutboundPolicyForTest(t *testing.T) {
+	t.Helper()
+	outboundPolicy.mu.Lock()
+	outboundPolicy.policy = nil
+	outboundPolicy.mu.Unlock()
+	t.Cleanup(func() {
+		outboundPolicy.mu.Lock()
+		outboundPolicy.policy = nil
+		outboundPolicy.mu.Unlock()
+	})
+}
+
+func TestOutboundPolicyRejectsBeforeUnderlyingDispatch(t *testing.T) {
+	resetOutboundPolicyForTest(t)
+	if err := SetOutboundPolicy(func(next http.RoundTripper) http.RoundTripper {
+		return rejectingPolicyTransport{next: next}
+	}); err != nil {
+		t.Fatalf("SetOutboundPolicy() error = %v", err)
+	}
+
+	base := &recordingTransport{}
+	client := ApplyOutboundPolicy(&http.Client{Transport: base})
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodPost, "https://example.invalid/v1/messages", nil)
+	if err != nil {
+		t.Fatalf("NewRequestWithContext() error = %v", err)
+	}
+	req.Header.Set("X-Blocked", "1")
+
+	_, err = client.Do(req)
+	if !errors.Is(err, errPolicyRejected) {
+		t.Fatalf("Do() error = %v, want policy rejection", err)
+	}
+	if base.calls != 0 {
+		t.Fatalf("underlying transport dispatched %d time(s) for a rejected request", base.calls)
+	}
+}
+
+func TestApplyOutboundPolicyRetainsSelectedTransportAndWrapsOnce(t *testing.T) {
+	resetOutboundPolicyForTest(t)
+	wraps := 0
+	if err := SetOutboundPolicy(func(next http.RoundTripper) http.RoundTripper {
+		wraps++
+		return next
+	}); err != nil {
+		t.Fatalf("SetOutboundPolicy() error = %v", err)
+	}
+
+	selected := &http.Transport{MaxIdleConns: 7}
+	client := ApplyOutboundPolicy(&http.Client{Transport: selected})
+	if got := UnwrapOutboundPolicy(client.Transport); got != http.RoundTripper(selected) {
+		t.Fatalf("UnwrapOutboundPolicy() = %T, want the selected *http.Transport", got)
+	}
+
+	again := ApplyOutboundPolicy(client)
+	if again != client {
+		t.Fatal("ApplyOutboundPolicy() re-wrapped an already policy-wrapped client")
+	}
+	if wraps != 1 {
+		t.Fatalf("policy wrapped %d time(s), want exactly 1", wraps)
+	}
+}
+
+func TestApplyOutboundPolicyFailsClosedOnNilPolicyResult(t *testing.T) {
+	resetOutboundPolicyForTest(t)
+	if err := SetOutboundPolicy(func(http.RoundTripper) http.RoundTripper { return nil }); err != nil {
+		t.Fatalf("SetOutboundPolicy() error = %v", err)
+	}
+
+	base := &recordingTransport{}
+	client := ApplyOutboundPolicy(&http.Client{Transport: base})
+	if _, err := client.Get("https://example.invalid/"); err == nil {
+		t.Fatal("Get() succeeded with a nil policy result; want fail-closed error")
+	}
+	if base.calls != 0 {
+		t.Fatalf("underlying transport dispatched %d time(s) despite fail-closed policy", base.calls)
+	}
+}
+
+func TestApplyOutboundPolicyIsNoOpWithoutPolicy(t *testing.T) {
+	resetOutboundPolicyForTest(t)
+	client := &http.Client{Transport: &recordingTransport{}}
+	if got := ApplyOutboundPolicy(client); got != client {
+		t.Fatal("ApplyOutboundPolicy() copied the client with no policy installed")
+	}
+}
+
+func TestDecorateWithNilContextStillAppliesPolicy(t *testing.T) {
+	resetOutboundPolicyForTest(t)
+	if err := SetOutboundPolicy(func(next http.RoundTripper) http.RoundTripper {
+		return rejectingPolicyTransport{next: next}
+	}); err != nil {
+		t.Fatalf("SetOutboundPolicy() error = %v", err)
+	}
+
+	base := &recordingTransport{}
+	client := Decorate(nil, &http.Client{Transport: base})
+	if _, ok := client.Transport.(*outboundPolicyTransport); !ok {
+		t.Fatalf("Decorate(nil, client) transport = %T, want policy-wrapped transport", client.Transport)
+	}
+
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodGet, "https://example.invalid/", nil)
+	if err != nil {
+		t.Fatalf("NewRequestWithContext() error = %v", err)
+	}
+	req.Header.Set("X-Blocked", "1")
+	if _, err := client.Do(req); !errors.Is(err, errPolicyRejected) {
+		t.Fatalf("Do() error = %v, want policy rejection", err)
+	}
+	if base.calls != 0 {
+		t.Fatalf("underlying transport dispatched %d time(s) for a rejected request", base.calls)
+	}
+}
+
+func TestSetOutboundPolicyRejectsNilAndReinstall(t *testing.T) {
+	resetOutboundPolicyForTest(t)
+	if err := SetOutboundPolicy(nil); err == nil {
+		t.Fatal("SetOutboundPolicy(nil) succeeded; want error")
+	}
+	identity := func(next http.RoundTripper) http.RoundTripper { return next }
+	if err := SetOutboundPolicy(identity); err != nil {
+		t.Fatalf("first SetOutboundPolicy() error = %v", err)
+	}
+	if err := SetOutboundPolicy(identity); err == nil {
+		t.Fatal("second SetOutboundPolicy() succeeded; an active policy must not be replaced")
+	}
+}
diff --git a/sdk/nativepolicy/strict_replay.go b/sdk/nativepolicy/strict_replay.go
new file mode 100644
index 0000000..502fef4
--- /dev/null
+++ b/sdk/nativepolicy/strict_replay.go
@@ -0,0 +1,29 @@
+// Package nativepolicy carries request-scoped policy for native provider
+// executors.
+//
+// The strict replay flag is an explicit opt-in for replaying provider-native
+// reasoning state (Claude thinking/redacted_thinking signatures, Codex reasoning
+// items, Gemini thought signatures) byte-for-byte. It is only a request-scope
+// switch. It is NOT an authentication, provenance, or privacy assertion: the
+// host MUST verify provider, model, account, and session binding of the replayed
+// state before setting it.
+package nativepolicy
+
+import "context"
+
+type strictReplayKey struct{}
+
+// WithStrictReplay returns a context that enables strict native reasoning replay
+// for requests executed with it.
+func WithStrictReplay(ctx context.Context) context.Context {
+	return context.WithValue(ctx, strictReplayKey{}, true)
+}
+
+// StrictReplay reports whether strict native reasoning replay was enabled on ctx.
+func StrictReplay(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	enabled, _ := ctx.Value(strictReplayKey{}).(bool)
+	return enabled
+}
diff --git a/sdk/cliproxy/compat_registration.go b/sdk/cliproxy/compat_registration.go
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/sdk/cliproxy/compat_registration.go
@@ -0,0 +1,55 @@
+package cliproxy
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+)
+
+// RegisterCompatExecutor installs an [OI]-compatible HTTP executor under providerKey,
+// so a host can route an operator-hosted model through the same managed egress as the
+// native providers. It fails when no outbound policy is installed, matching
+// RegisterNativeHTTPExecutors: traffic is never dispatched unpoliced.
+func RegisterCompatExecutor(manager *coreauth.Manager, providerKey string, cfg *config.Config) error {
+	if manager == nil {
+		return fmt.Errorf("cliproxy: compat executor registration requires a manager")
+	}
+	if strings.TrimSpace(providerKey) == "" {
+		return fmt.Errorf("cliproxy: compat executor registration requires a provider key")
+	}
+	if !httptransport.OutboundPolicyInstalled() {
+		return fmt.Errorf("cliproxy: compat executor registration requires an installed outbound policy")
+	}
+	manager.RegisterExecutor(executor.NewOpenAICompatExecutor(providerKey, cfg))
+	return nil
+}
+
+// RegisterCompatAuthModels registers an explicit model list for an [OI]-compatible
+// credential. Unlike a native provider it has no embedded catalog, so the models it
+// serves are declared by the host rather than looked up.
+func RegisterCompatAuthModels(authID, provider string, models []NativeModel) error {
+	if strings.TrimSpace(authID) == "" {
+		return fmt.Errorf("cliproxy: compat model registration requires an auth ID")
+	}
+	if len(models) == 0 {
+		return fmt.Errorf("cliproxy: compat model registration requires at least one model")
+	}
+	infos := make([]*registry.ModelInfo, 0, len(models))
+	for _, m := range models {
+		if strings.TrimSpace(m.ID) == "" {
+			return fmt.Errorf("cliproxy: compat model registration requires a model ID")
+		}
+		info := &registry.ModelInfo{ID: m.ID, DisplayName: m.Name, ContextLength: m.ContextWindow}
+		if len(m.SupportedEfforts) > 0 {
+			info.Thinking = &registry.ThinkingSupport{Levels: append([]string(nil), m.SupportedEfforts...)}
+		}
+		infos = append(infos, info)
+	}
+	registry.GetGlobalRegistry().RegisterClient(authID, provider, infos)
+	return nil
+}
