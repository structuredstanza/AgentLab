+package cliproxy
+
+import "github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+
+// CompatClientSupportsModel reports whether the registry knows a model for an
+// [OI]-compatible credential. It exists so the host can diagnose a compat auth that
+// registers successfully yet is never selected for a turn.
+func CompatClientSupportsModel(authID, model string) bool {
+	return registry.GetGlobalRegistry().ClientSupportsModel(authID, model)
+}
