+func strictClaudePayload(thinkingSignature, redactedData string) []byte {
+	return []byte(`{
+		"model": "` + strictClaudeReplayModel + `",
+		"thinking": {"type": "adaptive"},
+		"messages": [
+			{"role":"user","content":[{"type":"text","text":"hi"}]},
+			{"role":"assistant","content":[
+				{"type":"thinking","thinking":"earlier reasoning","signature":"` + thinkingSignature + `"},
+				{"type":"redacted_thinking","data":"` + redactedData + `"},
+				{"type":"text","text":"Answer"}
+			]},
+			{"role":"user","content":[{"type":"text","text":"continue"}]}
+		]
