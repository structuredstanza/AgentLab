@@ -0,0 +1,92 @@
+package helps
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+)
+
+var errHelpsPolicyRejected = errors.New("rejected by outbound policy")
+
+type helpsRejectingPolicy struct {
+	next  http.RoundTripper
+	calls *int
+}
+
+func (p helpsRejectingPolicy) RoundTrip(req *http.Request) (*http.Response, error) {
+	(*p.calls)++
+	if req.Header.Get("X-Blocked") != "" {
+		return nil, errHelpsPolicyRejected
+	}
+	return p.next.RoundTrip(req)
+}
+
+// Nil-context callers must neither panic nor bypass the outbound policy.
+// Run in a fresh process so the install-once policy cannot contaminate other fixtures.
+func TestNewProxyAwareHTTPClientNilContextKeepsPolicy(t *testing.T) {
+	if os.Getenv("CLIPROXY_POLICY_FIXTURE") != "1" {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestNewProxyAwareHTTPClientNilContextKeepsPolicy$")
+		cmd.Env = append(os.Environ(), "CLIPROXY_POLICY_FIXTURE=1")
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("isolated policy fixture: %v\n%s", err, out)
+		}
+		return
+	}
+	policyCalls := 0
+	if err := httptransport.SetOutboundPolicy(func(next http.RoundTripper) http.RoundTripper {
+		return helpsRejectingPolicy{next: next, calls: &policyCalls}
+	}); err != nil {
+		t.Fatal(err)
+	}
+	client := NewProxyAwareHTTPClient(nil, &config.Config{}, nil, 0)
+	req, err := http.NewRequest(http.MethodGet, "http://127.0.0.1:1/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("X-Blocked", "1")
+	if _, err := client.Do(req); !errors.Is(err, errHelpsPolicyRejected) {
+		t.Fatalf("nil-context request bypassed admission: %v", err)
+	}
+
+	dispatched := 0
+	base := &http.Client{Transport: helpsPolicyFixtureTransport{calls: &dispatched}}
+	prepared := httptransport.ApplyOutboundPolicy(base)
+	traced := WithAntigravityHTTPClientTrace(prepared, nil, "project_discovery")
+	client = httptransport.ApplyOutboundPolicy(traced)
+	req, err = http.NewRequest(http.MethodPost, "https://daily-cloudcode-pa.googleapis.com/v1internal:loadCodeAssist", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if policyCalls != 2 || dispatched != 1 {
+		t.Fatalf("traced request: admission calls=%d, native dispatches=%d", policyCalls, dispatched)
+	}
+	req.Header.Set("X-Blocked", "1")
+	if _, err := client.Do(req); !errors.Is(err, errHelpsPolicyRejected) {
+		t.Fatalf("traced request bypassed admission: %v", err)
+	}
+	if policyCalls != 3 || dispatched != 1 {
+		t.Fatalf("rejected trace: admission calls=%d, native dispatches=%d", policyCalls, dispatched)
+	}
+}
+
+type helpsPolicyFixtureTransport struct{ calls *int }
+
+func (t helpsPolicyFixtureTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	(*t.calls)++
+	return &http.Response{
+		StatusCode: http.StatusOK, Header: make(http.Header),
+		Body: io.NopCloser(strings.NewReader("{}")), Request: req,
+	}, nil
+}
diff --git a/internal/runtime/executor/native_replay_strict.go b/internal/runtime/executor/native_replay_strict.go
new file mode 100644
index 0000000..eab1e79
--- /dev/null
+++ b/internal/runtime/executor/native_replay_strict.go
@@ -0,0 +1,99 @@
+package executor
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	sigcompat "github.com/router-for-me/CLIProxyAPI/v8/internal/signature"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/nativepolicy"
+	"github.com/tidwall/gjson"
+)
+
+// validateStrictClaudeReplay fails locally when strict native replay would
+// forward a thinking block that cannot be replayed unchanged. Without the strict
+// flag it is a no-op, so the existing sanitizer path keeps its behavior.
+func validateStrictClaudeReplay(ctx context.Context, body []byte) error {
+	if !nativepolicy.StrictReplay(ctx) {
+		return nil
+	}
+	var err error
+	gjson.GetBytes(body, "messages").ForEach(func(msgIdx, msg gjson.Result) bool {
+		msg.Get("content").ForEach(func(blockIdx, block gjson.Result) bool {
+			switch strings.TrimSpace(block.Get("type").String()) {
+			case "thinking":
+				signature := block.Get("signature").String()
+				if !sigcompat.IsValidClaudeThinkingSignature(signature) && !sigcompat.IsValidClaudeCAISSignature(signature) {
+					err = fmt.Errorf("strict native replay: messages.%d.content.%d thinking signature is not replayable", msgIdx.Int(), blockIdx.Int())
+				}
+			case "redacted_thinking":
+				if strings.TrimSpace(block.Get("data").String()) == "" {
+					err = fmt.Errorf("strict native replay: messages.%d.content.%d redacted_thinking data is empty", msgIdx.Int(), blockIdx.Int())
+				}
+			}
+			return err == nil
+		})
+		return err == nil
+	})
+	return err
+}
+
+// validateStrictCodexReplay fails locally when a reasoning item cannot be
+// forwarded to the GPT Responses upstream with its native encrypted_content
+// intact. Compat requests and non-strict requests are a no-op.
+func validateStrictCodexReplay(ctx context.Context, body []byte, isCompat bool) error {
+	if isCompat || !nativepolicy.StrictReplay(ctx) {
+		return nil
+	}
+	var err error
+	gjson.GetBytes(body, "input").ForEach(func(idx, item gjson.Result) bool {
+		if strings.TrimSpace(item.Get("type").String()) != "reasoning" {
+			return true
+		}
+		encrypted := item.Get("encrypted_content")
+		if encrypted.Type != gjson.String || !sigcompat.IsValidGPTReasoningSignature(encrypted.String()) {
+			err = fmt.Errorf("strict native replay: input.%d reasoning encrypted_content is not replayable", idx.Int())
+		}
+		return err == nil
+	})
+	return err
+}
+
+// validateStrictGeminiReplay rejects invalid native thought signatures before
+// source translation or ordinary signature-cache handling can remove them.
+func validateStrictGeminiReplay(ctx context.Context, modelName string, rawJSON []byte) error {
+	if !nativepolicy.StrictReplay(ctx) || !antigravityUsesReasoningReplayCache(modelName) {
+		return nil
+	}
+	contentsPath := "request.contents"
+	contents := gjson.GetBytes(rawJSON, contentsPath)
+	if !contents.IsArray() {
+		contentsPath = "contents"
+		contents = gjson.GetBytes(rawJSON, contentsPath)
+	}
+	var err error
+	contents.ForEach(func(contentIdx, content gjson.Result) bool {
+		content.Get("parts").ForEach(func(partIdx, part gjson.Result) bool {
+			signature := part.Get("thoughtSignature")
+			if signature.Exists() && (signature.Type != gjson.String || !sigcompat.IsValidGeminiThoughtSignature(signature.String())) {
+				err = fmt.Errorf("strict native replay: %s.%d.parts.%d thoughtSignature is not replayable", contentsPath, contentIdx.Int(), partIdx.Int())
+			}
+			return err == nil
+		})
+		return err == nil
+	})
+	return err
+}
+
+// sanitizeGeminiReplayForRequest returns the Gemini request unchanged under
+// strict replay after rejecting any thoughtSignature that is not replayable.
+// Otherwise it applies the existing non-strict sanitizer.
+func sanitizeGeminiReplayForRequest(ctx context.Context, modelName string, rawJSON []byte) ([]byte, error) {
+	if !nativepolicy.StrictReplay(ctx) {
+		return sanitizeAntigravityGeminiRequestSignatures(modelName, rawJSON), nil
+	}
+	if err := validateStrictGeminiReplay(ctx, modelName, rawJSON); err != nil {
+		return nil, err
+	}
+	return rawJSON, nil
+}
