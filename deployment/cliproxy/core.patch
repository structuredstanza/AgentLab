+}
+
+func TestStrictReplayClaudePreservesSignedAndRedactedBlocks(t *testing.T) {
+	capture := &strictReplayCapture{}
+	ctx := strictReplayTestContext(true, capture.transport("application/json", strictClaudeMessageResponse))
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "key-strict-replay", "cloak_mode": "always"}}
+	request := cliproxyexecutor.Request{Model: strictClaudeReplayModel, Payload: strictClaudePayload(preservedThinkingTestSignature, "redacted-opaque-data")}
+	options := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude}
+
+	if _, err := NewClaudeExecutor(&config.Config{}).Execute(ctx, auth, request, options); err != nil {
+		t.Fatalf("Execute() error = %v", err)
+	}
+	if capture.calls != 1 {
+		t.Fatalf("upstream calls = %d, want 1", capture.calls)
+	}
+	if got := gjson.GetBytes(capture.body, "messages.1.content.0.signature").String(); got != preservedThinkingTestSignature {
+		t.Fatalf("thinking signature was not preserved byte-for-byte")
+	}
+	if got := gjson.GetBytes(capture.body, "messages.1.content.0.thinking").String(); got != "earlier reasoning" {
+		t.Fatalf("thinking text = %q, want preserved", got)
+	}
+	if got := gjson.GetBytes(capture.body, "messages.1.content.1.data").String(); got != "redacted-opaque-data" {
+		t.Fatalf("redacted_thinking data = %q, want preserved", got)
+	}
+	if gjson.GetBytes(capture.body, "thinking.block_binding.prefix_mismatch_behavior").Exists() {
+		t.Fatalf("strict replay injected drop_block; body=%s", string(capture.body))
+	}
+}
+
+func TestStrictReplayClaudeNonStrictControlInjectsDropBlock(t *testing.T) {
