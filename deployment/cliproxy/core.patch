new file mode 100644
index 0000000..3432aef
--- /dev/null
+++ b/sdk/auth/login_callback_test.go
@@ -0,0 +1,51 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+func freeLoopbackPort(t *testing.T) int {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("net.Listen() error = %v", err)
+	}
+	defer func() { _ = listener.Close() }()
+	return listener.Addr().(*net.TCPAddr).Port
+}
+
+// A failing AuthorizationURL hook must abort the login before the URL is
+// exposed (Progress is never reached) and must surface the hook error.
+func TestClaudeLoginAbortsWhenAuthorizationCallbackFails(t *testing.T) {
+	sentinel := errors.New("host refused to expose the authorization URL")
+	progressCalls := 0
+	exposedURL := ""
+	opts := &LoginOptions{
+		NoBrowser:    true,
+		CallbackPort: freeLoopbackPort(t),
+		AuthorizationURL: func(authURL string) error {
+			exposedURL = authURL
+			return sentinel
+		},
+		Progress: func(string) { progressCalls++ },
+	}
+
+	record, err := NewClaudeAuthenticator().Login(context.Background(), &config.Config{}, opts)
+	if !errors.Is(err, sentinel) {
+		t.Fatalf("Login() error = %v, want wrapped callback error", err)
+	}
+	if record != nil {
+		t.Fatalf("Login() returned a record %+v after callback failure", record)
+	}
+	if progressCalls != 0 {
+		t.Fatalf("Progress called %d time(s); login continued past the failed callback", progressCalls)
+	}
+	if exposedURL == "" {
+		t.Fatal("AuthorizationURL was never offered the authorization URL")
+	}
+}
