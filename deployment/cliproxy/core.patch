+
+	result, err := NewAntigravityExecutor(&config.Config{}).ExecuteStream(ctx, strictGeminiAuth(), cliproxyexecutor.Request{
+		Model: "gemini-3-pro-preview",
+		Payload: []byte(`{"contents":[` +
+			`{"role":"user","parts":[{"text":"hi"}]},` +
+			`{"role":"model","parts":[` +
+			`{"text":"reasoning","thought":true,"thoughtSignature":"` + sig + `"},` +
+			`{"functionCall":{"name":"lookup","args":{"q":"x"}},"thoughtSignature":"` + sig + `"},` +
+			`{"thoughtSignature":"` + sig + `"}` +
+			`]},` +
+			`{"role":"user","parts":[{"functionResponse":{"name":"lookup","response":{"ok":true}}}]}` +
+			`]}`),
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatGemini, ResponseFormat: sdktranslator.FormatGemini})
+	if err != nil {
+		t.Fatalf("ExecuteStream() error = %v", err)
+	}
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("stream chunk error = %v", chunk.Err)
+		}
+	}
+	if capture.calls != 1 {
+		t.Fatalf("upstream calls = %d, want 1", capture.calls)
+	}
+	if got := strings.Count(string(capture.body), sig); got < 3 {
+		t.Fatalf("signature occurrences = %d, want all 3 signed parts preserved; body=%s", got, string(capture.body))
+	}
+	if !strings.Contains(string(capture.body), `"functionResponse"`) {
+		t.Fatalf("functionResponse missing from upstream body; body=%s", string(capture.body))
+	}
+}
+
+func TestStrictReplayGeminiRejectsInvalidSignatureBeforeDispatch(t *testing.T) {
+	capture := &strictReplayCapture{}
+	ctx := strictReplayTestContext(true, capture.transport("text/event-stream", strictGeminiStreamResponse))
+
+	_, err := NewAntigravityExecutor(&config.Config{}).ExecuteStream(ctx, strictGeminiAuth(), cliproxyexecutor.Request{
+		Model: "gemini-3-pro-preview",
+		Payload: []byte(`{"contents":[{"role":"model","parts":[` +
+			`{"text":"reasoning","thought":true,"thoughtSignature":"not-a-gemini-signature"}` +
+			`]}]}`),
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatGemini, ResponseFormat: sdktranslator.FormatGemini})
+	if err == nil {
+		t.Fatal("ExecuteStream() error = nil, want strict replay rejection")
+	}
+	if capture.calls != 0 {
+		t.Fatalf("upstream calls = %d, want 0 before dispatch", capture.calls)
+	}
+}
