+func strictReplayTestContext(strict bool, transport http.RoundTripper) context.Context {
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", transport)
+	if strict {
+		return nativepolicy.WithStrictReplay(ctx)
+	}
+	return ctx
+}
