diff --git a/sdk/cliproxy/native_http.go b/sdk/cliproxy/native_http.go
new file mode 100644
index 0000000..e8ccc6b
--- /dev/null
+++ b/sdk/cliproxy/native_http.go
@@ -0,0 +1,106 @@
+package cliproxy
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+)
+
+// NativeModel describes one model from the embedded static catalog of a native provider.
+type NativeModel struct {
+	ID               string
+	Name             string
+	ContextWindow    int
+	SupportedEfforts []string
+}
+
+// RegisterNativeHTTPExecutors installs the HTTP-only native executors for Claude,
+// Codex, and Antigravity on manager. It fails when no outbound policy is installed,
+// so traffic from these executors is never dispatched unpoliced. WebSocket and
+// auto-routing executors are not registered.
+func RegisterNativeHTTPExecutors(manager *coreauth.Manager, cfg *config.Config) error {
+	if manager == nil {
+		return fmt.Errorf("cliproxy: native executor registration requires a manager")
+	}
+	if !httptransport.OutboundPolicyInstalled() {
+		return fmt.Errorf("cliproxy: native executor registration requires an installed outbound policy")
+	}
+	manager.RegisterExecutor(executor.NewClaudeExecutor(cfg))
+	manager.RegisterExecutor(executor.NewCodexExecutor(cfg))
+	manager.RegisterExecutor(executor.NewAntigravityExecutor(cfg))
+	return nil
+}
+
+// NativeModels returns the embedded static catalog for a native provider. It does
+// not use the network or refresh capability hints.
+func NativeModels(provider string) ([]NativeModel, error) {
+	infos, err := nativeModelInfos(provider)
+	if err != nil {
+		return nil, err
+	}
+	models := make([]NativeModel, 0, len(infos))
+	for _, info := range infos {
+		if info == nil {
+			continue
+		}
+		name := info.DisplayName
+		if name == "" {
+			name = info.ID
+		}
+		model := NativeModel{ID: info.ID, Name: name, ContextWindow: info.ContextLength}
+		if info.Thinking != nil {
+			model.SupportedEfforts = append([]string(nil), info.Thinking.Levels...)
+		}
+		models = append(models, model)
+	}
+	return models, nil
+}
+
+func nativeModelInfos(provider string) ([]*registry.ModelInfo, error) {
+	switch provider {
+	case "claude", "codex", "antigravity":
+	default:
+		return nil, fmt.Errorf("cliproxy: unsupported native provider")
+	}
+	infos := registry.GetStaticModelDefinitionsByChannel(provider)
+	if provider == "antigravity" {
+		for _, info := range infos {
+			if info != nil && info.ID == "gemini-4-argon-high" {
+				// The previous pinned catalog routes Argon low/medium/high to distinct native SKUs.
+				for _, level := range []string{"low", "medium"} {
+					model := *info
+					model.ID = "gemini-4-argon-" + level
+					model.Name = model.ID
+					model.MetadataModelID = info.ID
+					infos = append(infos, &model)
+				}
+				break
+			}
+		}
+	}
+	return infos, nil
+}
+
+// RegisterNativeAuthModels registers only local native catalog metadata, without probes.
+// Call before manager.Register, or refresh that manager's scheduler entry afterwards.
+func RegisterNativeAuthModels(authID, provider string) error {
+	if strings.TrimSpace(authID) == "" {
+		return fmt.Errorf("cliproxy: native model registration requires an auth ID")
+	}
+	models, err := nativeModelInfos(provider)
+	if err != nil {
+		return err
+	}
+	registry.GetGlobalRegistry().RegisterClient(authID, provider, models)
+	return nil
+}
+
+// UnregisterNativeAuthModels removes a credential's local model registrations.
+func UnregisterNativeAuthModels(authID string) {
+	registry.GetGlobalRegistry().UnregisterClient(authID)
+}
