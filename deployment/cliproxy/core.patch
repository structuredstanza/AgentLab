+// envelope from internal/signature/gemini_validation_test.go.
+const strictGeminiThoughtSignatureForTest = "EjQKMgEMOdbHO0Gd+c9Mxk4ELwPGbpCEcp2mFfYYLix2UVtBH3fL8GECc4+JITVnHF4qZDsA"
+
+// strictReplayCapture counts synthetic upstream dispatches and keeps the last body.
+type strictReplayCapture struct {
+	calls int
+	body  []byte
+}
+
+func (c *strictReplayCapture) transport(contentType, responseBody string) http.RoundTripper {
+	return roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		c.calls++
+		body, errRead := io.ReadAll(req.Body)
+		if errRead != nil {
+			return nil, errRead
+		}
+		c.body = body
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     http.Header{"Content-Type": []string{contentType}},
+			Body:       io.NopCloser(strings.NewReader(responseBody)),
+			Request:    req,
+		}, nil
+	})
+}
