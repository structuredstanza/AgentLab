# Docker deployment settings (copy this file to .env)
# M1NERVAC0NSOLE_TAG selects the image tag that docker-compose uses (default `local`).
# Compose builds the image from this tree by default; set M1NERVAC0NSOLE_TAG only when you
# want to run an image you already built or pulled (for example a release tag).
M1NERVAC0NSOLE_TAG=local
POSTGRES_USER=m1nervac0nsole
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=m1nervac0nsole

# LLM (fill in one or both, or leave empty and configure later in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
M1NERVAC0NSOLE_LLM_PROVIDER=
M1NERVAC0NSOLE_LLM_MODEL=
M1NERVAC0NSOLE_LLM_BASE_URL=
M1NERVAC0NSOLE_LLM_PROXY=

# First-run protection (prevents remote takeover of the admin account)
# - The web/API port is published only on the host's 127.0.0.1 by default. To reach it from
#   another machine, set M1NERVAC0NSOLE_BIND=0.0.0.0, but finish the initial setup first.
# - On first start, a random setup token is printed to the log (docker compose logs m1nervac0nsole),
#   and you must enter it on the /setup page to create the admin password.
#   If M1NERVAC0NSOLE_SETUP_TOKEN is set, that value is the token and nothing is printed to the log.
# - If M1NERVAC0NSOLE_ADMIN_PASSWORD is set, initialization happens immediately with that value (8+ characters), skipping /setup.
M1NERVAC0NSOLE_BIND=127.0.0.1
M1NERVAC0NSOLE_SETUP_TOKEN=
M1NERVAC0NSOLE_ADMIN_PASSWORD=
# Browser cross-origin (CORS) allowlist, comma-separated. The built-in UI is same-origin, so leave this empty.
M1NERVAC0NSOLE_CORS_ORIGINS=
