# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# Single-binary artifact with the frontend embedded
/m1nervac0nsole
# Intermediate artifacts left next to the executable by one-click updates (staged files / backups / failed versions / upgrade markers)
/m1nervac0nsole.new
/m1nervac0nsole.new.sha256
/m1nervac0nsole.old
/m1nervac0nsole.failed
/m1nervac0nsole.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never commit)
/jwt.key

# Local environment generated by Docker deployment (contains passwords/keys, do not commit)
.env

# Event logs produced by scheduler runs/simulations (test artifacts, do not commit)
*-events.csv

# bench benchmark-related files (local artifacts, do not commit)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# --- m1nervac0nsole local operations: do not commit (owner instruction: test/scan results kept private) ---
work/
test-results/
scan-output/
evidence-local/
# Runtime data generated when the demo app is started locally (the recording proxy traffic index DB,
# the mitmproxy CA private key, etc.) is not committed to the public repository (BRIEF boundary #2).
/demo-data/
*.local.env
# D2 model comparison live test: since it is internal to package agent, it has to live outside work/,
# it is a local-only artifact that consumes OPENROUTER_API_KEY and the network, so it must not be
# committed to the public repository (BRIEF boundary #2). Only the exact path is excluded, so the upstream trace test is left untouched.
agent/d2_models_live_test.go

# API keys and secrets: do not commit them, wherever they are placed
*.env
secrets.env

# --- Local build artifacts for Windows source builds: do not commit ---
# Windows single binary produced by go build -o m1nervac0nsole.exe (corresponds to the Unix /m1nervac0nsole)
/m1nervac0nsole.exe
# Local secrets used in config, e.g. PostgreSQL password. Never commit.
/.secrets/
# Native binding cache created when SWC_NATIVE_BINDING_CACHE is run under the project subdirectory
/.swc-cache/
# Runtime log redirected when running m1nervac0nsole.exe in the foreground
/m1nervac0nsole.out.log
/m1nervac0nsole.err.log
# graft/trail structural index cache (local navigation only)
/graft/
# Benchmark run output (scripts/benchmark/run_bench.py)
benchmark-results/
