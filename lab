def start_provider_proxy():
    if not PROXY_BIN.is_file():
        raise RuntimeError(f'Native provider proxy is not built: {PROXY_BIN}')
    for path in (PROXY_STATE, PROXY_STATE / 'home', PROXY_STATE / 'network'):
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
        path.chmod(0o700)
    try:
        fd = os.open(PROXY_TOKEN, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        pass
    else:
        with os.fdopen(fd, 'w') as stream:
            stream.write(secrets.token_urlsafe(48) + '\n')
    PROXY_TOKEN.chmod(0o600)
    unit = PROXY_UNIT
    installed = Path.home() / '.config/systemd/user/m1nervac0nsole-cliproxy.service'
    installed.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if installed.exists() or installed.is_symlink():
        if installed.resolve() != unit.resolve():
            raise RuntimeError(f'Refusing to replace an unrelated service: {installed}')
    else:
        installed.symlink_to(unit)
    subprocess.run(['systemctl', '--user', 'daemon-reload'], check=True, timeout=30)
    subprocess.run(['systemctl', '--user', 'start', unit.name], check=True, timeout=40)
    deadline = time.monotonic() + 30
    while True:
        try:
            with urllib.request.urlopen('http://127.0.0.1:8788/healthz', timeout=2) as response:
                if json.load(response).get('status') == 'ok':
                    return
        except (OSError, ValueError):
            pass
        if time.monotonic() >= deadline:
            raise RuntimeError('native provider proxy did not become healthy; inspect m1nervac0nsole-cliproxy.service')
        time.sleep(0.2)


def stage_vpn(profile):
    """Copy an OpenVPN profile into the guest, or clear a previously staged one.

    Staged before the supervisor starts so guest-start.py can bring the tunnel up
    ahead of tcpdump. Always rewritten or removed: a profile left from an earlier
    start would silently route a later engagement through someone else's tunnel.
    """
    target = '/run/secrets/openvpn-profile.ovpn'
    if profile is None:
        guest('python3', '-c',
              f'import os\np = {target!r}\n'
              'if os.path.exists(p):\n    os.unlink(p)\n')
        return
    source = Path(profile).expanduser().resolve()
    if not source.is_file():
        raise RuntimeError(f'OpenVPN profile not found: {source}')
    if source.suffix not in ('.ovpn', '.conf'):
        raise RuntimeError(f'OpenVPN profile must be .ovpn or .conf, got {source.suffix or "no extension"}')
    payload = source.read_bytes()
    if b'auth-user-pass' in payload and b'<' not in payload:
        raise RuntimeError('profile uses auth-user-pass without an inline block; a start would hang waiting for a password')
    # Stream the bytes in rather than copying through a bind mount: the profile is
    # a credential, and it should exist in the guest only for the run that asked.
    proc = subprocess.run([str(MSB), 'exec', '--stream', NAME, '--', 'python3', '-c',
                           'import os, sys, hashlib\n'
                           f'p = {target!r}\n'
                           'os.makedirs(os.path.dirname(p), mode=0o700, exist_ok=True)\n'
                           'data = sys.stdin.buffer.read()\n'
                           'fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)\n'
                           'os.write(fd, data)\n'
                           'os.fsync(fd)\n'
                           'os.close(fd)\n'
                           'os.chmod(p, 0o600)\n'
                           'print(hashlib.sha256(data).hexdigest())\n'],
                          input=payload, capture_output=True)
    if proc.returncode:
        raise RuntimeError('could not stage the OpenVPN profile in the guest: '
                           + proc.stderr.decode(errors='replace').strip()[:300])
    remote = proc.stdout.decode().strip().splitlines()[-1]
    local = hashlib.sha256(payload).hexdigest()
    if remote != local:
        raise RuntimeError(f'OpenVPN profile checksum mismatch: guest {remote[:16]}… host {local[:16]}…')
    print(f'OpenVPN profile staged ({len(payload)} bytes, sha256 {local[:16]}…)')

def other_running_agentlab():
    """Running m1nervac0nsole-agentlab-* sandboxes other than NAME, which share state/."""
    listing = subprocess.run([str(MSB), 'list', '--running', '-q'],
                             capture_output=True, text=True)
    if listing.returncode:
        raise RuntimeError('Could not list running sandboxes: '
                           + listing.stderr.strip()[:300])
    return [name for name in listing.stdout.split()
            if name.startswith('m1nervac0nsole-agentlab-') and name != NAME]


STATE_DIR = ROOT / 'state'
SANDBOX_CONF = ROOT / 'deployment/sandbox.yaml'
# Refuse to boot (or recreate) when the host filesystem holding state/ is nearly full:
# the /state quota is only a ceiling, so a quota larger than the free space would let
# the capture ring and PostgreSQL fill the host disk instead of failing early.
MIN_HOST_FREE_GB = int(os.environ.get('AGENTLAB_MIN_HOST_FREE_GB', '20'))


def state_quota_mb(gb=None):
    """The /state mount quota in MiB, or None to keep deployment/sandbox.yaml's default.

    0 means no quota (bounded only by the host disk). The quota is a mount option fixed
    when the sandbox is created and `msb modify` cannot change it, so a change needs
    `./lab resize-state`.
    """
    raw = os.environ.get('AGENTLAB_STATE_QUOTA_GB') if gb is None else gb
    if raw in (None, ''):
        return None
    try:
        value = int(raw)
    except (TypeError, ValueError):
        raise RuntimeError(f'state quota must be a whole number of GiB, got {raw!r}') from None
    if value < 0:
        raise RuntimeError('state quota cannot be negative; use 0 for no quota')
    return value * 1024


def sandbox_conf(quota_mb):
    """Return (path, temporary): the spec to create the sandbox from.

    With quota_mb None the checked-in spec is used as is. Otherwise a private copy
    with only the /state quota rewritten is written, so the base file stays the single
    source of truth for everything else.
    """
    if quota_mb is None:
        return SANDBOX_CONF, False
    text = SANDBOX_CONF.read_text()
    pattern = re.compile(r'(:/state)(?::quota=\d+)?(?=\s*$)', re.M)
    replacement = r'\1' if quota_mb == 0 else rf'\1:quota={quota_mb}'
    text, count = pattern.subn(replacement, text)
    if count != 1:
        raise RuntimeError(f'expected exactly one /state mount in {SANDBOX_CONF}, found {count}')
    handle = tempfile.NamedTemporaryFile('w', suffix='.yaml', prefix='lab-sandbox-', dir=ROOT,
                                         delete=False)
    with handle:
        handle.write(text)
    return Path(handle.name), True


def check_host_space():
    free_gb = shutil.disk_usage(STATE_DIR).free / 2**30
    if free_gb < MIN_HOST_FREE_GB:
        raise RuntimeError(f'only {free_gb:.1f} GiB free on the filesystem holding state/; need at least '
                           f'{MIN_HOST_FREE_GB} GiB (AGENTLAB_MIN_HOST_FREE_GB)')
    return free_gb


def create_sandbox(quota_mb=None):
    check_host_space()
    conf, temporary = sandbox_conf(quota_mb)
    try:
        msb('create', '--name', NAME, '--conf', str(conf),
            '--hostname', 'agentlab-worker',
            '--net-rule', 'allow@host:tcp:8080', '--net-rule', 'allow@host:tcp:8788')
    finally:
        if temporary:
            conf.unlink(missing_ok=True)


def resize_state(gb, confirmed):
    """Recreate the sandbox with a different /state quota. The state/ data is untouched.

    The quota cannot be edited in place, so the sandbox is removed and created again.
    Anything written to the sandbox's own root disk outside /state is lost, which is
    why this needs --yes and a stopped VM.
    """
    quota_mb = state_quota_mb(gb)
    inspected = subprocess.run([str(MSB), 'inspect', NAME, '--format', 'json'],
                               capture_output=True, text=True)
    if inspected.returncode == 0:
        if json.loads(inspected.stdout)['status'].lower() == 'running':
            raise RuntimeError('Stop the VM first (./lab stop); the quota cannot change while it runs')
        if not confirmed:
            raise RuntimeError(f'resize-state recreates {NAME}: state/ is kept, but files written to the VM root '
                               'disk outside /state are lost. Re-run with --yes to proceed')
        msb('remove', NAME)
    create_sandbox(quota_mb)
    msb('stop', NAME)
    label = 'no quota' if quota_mb == 0 else f'{quota_mb // 1024} GiB'
    print(f'{NAME} recreated with a {label} /state quota; run ./lab start')


GUEST_DIST = ROOT / 'deployment/guest-dist'
M1NERVAC0NSOLE_SRC = ROOT / 'm1nervac0nsole'
# Inputs of the guest build. Generated trees (out/, dist/, node_modules) are
# skipped: a build rewrites them, so counting them would make every check stale.
BUILD_INPUTS = [M1NERVAC0NSOLE_SRC / name for name in (
    'cmd', 'agent', 'db', 'manifest', 'server', 'skills', 'web/src', 'web/messages',
    'go.mod', 'go.sum', 'build.sh', 'web/package.json', 'web/package-lock.json',
)] + [ROOT / 'deployment/guest-start.py', ROOT / 'deployment/guest-export.py']
BUILD_SKIP = {'node_modules', '.next', 'out', 'dist', 'graphify-out', '__pycache__'}


def newest_build_input():
    newest = 0.0
    for path in BUILD_INPUTS:
        if path.is_dir():
            for root, dirs, files in os.walk(path):
                dirs[:] = [d for d in dirs if d not in BUILD_SKIP]
                for name in files:
                    newest = max(newest, os.path.getmtime(os.path.join(root, name)))
        elif path.exists():
            newest = max(newest, os.path.getmtime(path))
    return newest


def guest_dist_stale(binary=GUEST_DIST / 'm1nervac0nsole'):
    """True when the guest build is missing or older than any source it is built from."""
    try:
        built = os.path.getmtime(binary)
    except OSError:
        return True
    return newest_build_input() > built


def build_guest_dist(force=False):
    """Build the binary and stage skills and guest scripts for the /dist mount.

    `lab start` calls this, so the VM runs the current source rather than whatever
    the image baked in, and a source change rebuilds everything on the next start.
    """
    if not force and not guest_dist_stale():
        return GUEST_DIST
    GUEST_DIST.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, M1NERVAC0NSOLE_COMPRESS='off', M1NERVAC0NSOLE_SKIP_NPM_CI='1',
               M1NERVAC0NSOLE_OUTPUT=str(GUEST_DIST / 'm1nervac0nsole'))
    subprocess.run([str(M1NERVAC0NSOLE_SRC / 'build.sh')], env=env, check=True)
    shutil.rmtree(GUEST_DIST / 'skills', ignore_errors=True)
    shutil.copytree(M1NERVAC0NSOLE_SRC / 'skills', GUEST_DIST / 'skills')
    for name in ('guest-start.py', 'guest-export.py'):
        shutil.copy2(ROOT / 'deployment' / name, GUEST_DIST / name)
    return GUEST_DIST


def guest_file(path):
    """True when the running guest has path (the /dist mount is present)."""
    return subprocess.run([str(MSB), 'exec', '--no-stdin', NAME, '--', 'test', '-f', path],
                          capture_output=True).returncode == 0


def start(vpn=None, quota_gb=None):
    start_provider_proxy()
    build_guest_dist()
    for name in other_running_agentlab():
        raise RuntimeError(f'Stop the previous {name} VM gracefully before sharing its persistent state')
    result = subprocess.run([str(MSB), 'inspect', NAME, '--format', 'json'],
                            capture_output=True, text=True)
    if result.returncode:
        create_sandbox(state_quota_mb(quota_gb))
    elif json.loads(result.stdout)['status'].lower() != 'running':
        msb('start', NAME)
    if not guest_file('/dist/m1nervac0nsole'):
        raise RuntimeError(f'{NAME} predates the /dist mount that carries the current build; '
                           'recreate it with ./lab resize-state <GB> --yes (state/ is kept)')
    healthy = True
    try:
        api('/api/health')
    except Exception:
        healthy = False
    if healthy:
        if vpn is not None:
            raise RuntimeError('m1nervac0nsole is already running without the requested VPN; run ./lab stop and start again with --vpn')
    else:
        stage_vpn(vpn)
        msb('exec', '-d', NAME, '--', 'python3', '/dist/guest-start.py')
        deadline = time.monotonic() + 120
        while True:
            try:
                api('/api/health')
                break
            except Exception:
                if time.monotonic() >= deadline:
                    raise RuntimeError('m1nervac0nsole did not become healthy; inspect state/captures and msb logs')
                time.sleep(1)
    token = login()
    settings = api('/api/settings', {'llm_record': True, 'traffic_capture': True,
                    'agent_traffic_binding': True, 'llm_refusal_fallback_enabled': True}, token, 'PUT')
    settings = api('/api/settings', token=token)
    if not all(settings.get(key) for key in ('llm_record', 'traffic_capture', 'agent_traffic_binding', 'llm_refusal_fallback_enabled')):
        raise RuntimeError('m1nervac0nsole capture/refusal fallback settings are not enabled')
    print(f'm1nervac0nsole ready: {URL}; user minerva; password: {ROOT}/secrets/admin-password')
    active = next((p for p in api('/api/llm/profiles', token=token)['profiles'] if p['is_default']), None)
    if active and active.get('base_url') == PRIMARY_URL:
        start_primary_model()
    print('Capture enabled. Primary model: ' + (active['name'] if active else 'not configured'))


def start_primary_model():
    subprocess.run(['systemctl', '--user', 'start', 'bonsai.service'], check=True, timeout=60)
    deadline = time.monotonic() + 600
    while True:
        try:
            with urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2) as response:
                healthy = json.load(response).get('status') == 'ok'
        except (OSError, ValueError):
            healthy = False
        if healthy:
            return primary_runtime()
        if time.monotonic() >= deadline:
            raise RuntimeError('Shared Bonsai model is not healthy; inspect bonsai.service')
        time.sleep(2)


def primary_runtime():
    key = PRIMARY_KEY.read_text().strip()
    if not key:
        raise RuntimeError('Shared Bonsai API key is empty')
    request = urllib.request.Request('http://127.0.0.1:8080/props',
        headers={'Authorization': 'Bearer ' + key})
    with urllib.request.urlopen(request, timeout=30) as response:
        runtime = json.load(response)
    expected = json.loads((ROOT / 'deployment/provenance.json').read_text())['model_artifact']
    loaded = Path(runtime.get('model_path', '')).resolve()
    if runtime.get('model_alias') != 'bonsai-2-27b' or loaded != Path(expected['path']).resolve():
        raise RuntimeError('Shared backend is serving a different model artifact')
    identity = loaded.stat()
    if identity.st_size != expected['size_bytes'] or identity.st_mtime_ns != expected['mtime_ns']:
        raise RuntimeError('Model weights changed; reverify their hash before recording new provenance')
    return runtime


def primary():
    """Activate the installed open-weight backend without adding paid fallbacks."""
    runtime = start_primary_model()
    key = PRIMARY_KEY.read_text().strip()
    if not key:
        raise RuntimeError('Shared Bonsai API key is empty')
    token = login()
    profiles = api('/api/llm/profiles', token=token)['profiles']
    profile = {
        'name': PRIMARY_NAME, 'format': 'openai', 'base_url': PRIMARY_URL,
        'model': 'bonsai-2-27b', 'api_key': key, 'streaming': True,
        'context_window_k': 256, 'max_tokens': 32768,
        'thinking_type': '', 'reasoning_effort': 'medium', 'pool_exclude': True,
    }
    existing = next((p for p in profiles if p['name'] == PRIMARY_NAME), None)
    if existing:
        profile['id'] = int(existing['id'])
    profile_id = api('/api/llm/profiles', profile, token, 'POST')['id']
    api('/api/llm/profiles/active', {'id': profile_id}, token, 'POST')
    api('/api/settings', {'llm_record': True, 'traffic_capture': True,
        'agent_traffic_binding': True, 'llm_pool_enabled': False}, token, 'PUT')
    active = next(p for p in api('/api/llm/profiles', token=token)['profiles'] if p['is_default'])
    if str(active['id']) != str(profile_id) or active['base_url'] != PRIMARY_URL:
        raise RuntimeError('Primary model activation did not persist')
    provenance_path = ROOT / 'deployment/provenance.json'
    provenance = json.loads(provenance_path.read_text())
    provenance['model_backend'] = 'llama.cpp / shared bonsai.service'
    provenance['primary_model'] = {k: v for k, v in active.items()
                                   if k not in ('api_key', 'api_key_hint')}
    provenance.setdefault('reasoning_profiles', {})[PRIMARY_NAME] = {
        'model_backend': 'llama.cpp', 'provenance': 'open-weight-local',
    }
    provenance['inference_runtime'] = {k: runtime.get(k) for k in (
        'model_path', 'model_alias', 'model_ftype', 'build_info',
        'default_generation_settings', 'total_slots', 'chat_template_caps')}
    provenance['inference_runtime']['chat_template_sha256'] = hashlib.sha256(
        runtime.get('chat_template', '').encode()).hexdigest()
    provenance_path.write_text(json.dumps(provenance, indent=2) + '\n')
    print(json.dumps({'primary_profile': profile_id, 'name': PRIMARY_NAME,
        'model': active['model'], 'base_url': active['base_url'],
        'paid_fallbacks': False}, indent=2))


def stop():
    guest('python3', '-c', """
import os
import time
from pathlib import Path
path = Path('/state/supervisor.pid')
if path.exists():
    pid = int(path.read_text())
    try:
        command = Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\\0')
    except FileNotFoundError:
        command = []
    if b'/opt/agentlab/guest-start.py' in command or b'/dist/guest-start.py' in command:
        try:
            os.kill(pid, 15)
        except ProcessLookupError:
            pass
        for _ in range(600):
            if not path.exists():
                break
            time.sleep(0.25)
        else:
            raise RuntimeError('Supervisor did not shut down cleanly; VM left running')
""")
    # The staged OpenVPN profile is a credential; it must not outlive the run that
    # asked for it, or a later start would tunnel through someone else's endpoint.
    guest('python3', '-c',
          "import os\np = '/run/secrets/openvpn-profile.ovpn'\n"
          "if os.path.exists(p):\n    os.unlink(p)\n")
    msb('stop', NAME)


def execute(command):
    if command and command[0] == '--':
        command = command[1:]
    if not command:
        raise ValueError('exec requires a command after --')
    log = ROOT / 'host-events.jsonl'
    command_id = uuid.uuid4().hex
    with log.open('ab', buffering=0) as events:
        def event(kind, **data):
            line = json.dumps({'timestamp': now(), 'command_id': command_id, 'kind': kind, **data}) + '\n'
            os.write(events.fileno(), line.encode())
        event('command_start', argv=command)
        proc = subprocess.Popen([str(MSB), 'exec', '--no-stdin', NAME, '--', *command],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        with selectors.DefaultSelector() as streams:
            streams.register(proc.stdout, selectors.EVENT_READ, ('stdout', sys.stdout.buffer))
            streams.register(proc.stderr, selectors.EVENT_READ, ('stderr', sys.stderr.buffer))
            while streams.get_map():
                for key, _ in streams.select():
                    chunk = os.read(key.fd, 65536)
                    if not chunk:
                        streams.unregister(key.fileobj)
                        key.fileobj.close()
                        continue
                    kind, target = key.data
                    event(kind, data_base64=base64.b64encode(chunk).decode())
                    try:
                        target.write(chunk)
                        target.flush()
                    except BrokenPipeError:
                        pass  # Continue draining and recording the command when its display pipe closes.
        code = proc.wait()
        event('command_exit', argv=command, exit_code=code)
    return code


def extract_capture_archive(stream, destination):
    def regular_files_only(member, path):
        if not member.isfile() and not member.isdir():
            raise ValueError(f'Non-regular guest archive member rejected: {member.name}')
        filtered = tarfile.data_filter(member, path)
        filtered.mode = 0o700 if filtered.isdir() else 0o600
        return filtered
    with tarfile.open(fileobj=stream, mode='r|') as archive:
        archive.extractall(destination, filter=regular_files_only)


def export_provider_proxy_traffic(raw):
    capture_dir = PROXY_STATE / 'captures'
    source = capture_dir / 'native-sse.ndjson'
    if PROXY_STATE.is_symlink() or capture_dir.is_symlink() or source.is_symlink():
        raise RuntimeError('Refusing symlinked native provider capture')
    if not source.exists():
        return None
    if not source.is_file():
        raise RuntimeError('Native provider capture is not a regular file')

    target_dir = raw / 'provider-proxy-traffic'
    target_dir.mkdir(mode=0o700)
    target_dir.chmod(0o700)
    target = target_dir / 'native-sse.ndjson'
    created = False
    try:
        with source.open('rb') as source_stream, target.open('xb') as target_stream:
            created = True
            shutil.copyfileobj(source_stream, target_stream)
        target.chmod(0o600)
        with target.open('rb') as stream:
            checksum = hashlib.file_digest(stream, 'sha256').hexdigest()
    except BaseException:
        if created:
            target.unlink(missing_ok=True)
        raise
    return {
        'source': 'proxy-state/captures/native-sse.ndjson',
        'artifact': 'raw/provider-proxy-traffic/native-sse.ndjson',
        'format': 'NDJSON privacy.Record; Body is base64-encoded',
        'correlation_fields': ['Direction', 'Provider', 'Model', 'Profile', 'SessionID'],
        'scope': 'Native provider inference HTTP request/response bodies before core response translation or aggregation; not a PCAP or full wire capture',
        'privacy': 'Raw provider HTTP bodies and path/content metadata may be sensitive; SessionID is client-supplied opaque data; keep private',
        'sha256': checksum,
    }



def export():
    export_id = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
    output = ROOT / 'exports' / export_id
    raw = output / 'raw'
    raw.mkdir(parents=True, mode=0o700)
    manifest = {'started_at': now(), 'sandbox': NAME, 'model_data': 'genuine records only',
                'consistency': 'transactional PostgreSQL rows; separate pg_dump snapshot; online filesystem copy',
                'privacy': 'raw artifacts may contain credentials, task content and personal data',
                # Deliberate: the raw table dump is verbatim, so credential columns
                # travel with it -- llm_profiles.api_key, llm_profiles.api_key_hint,
                # oauth_grants.access_token/refresh_token, task_credentials.password
                # and notify_channels.config. This keeps an export faithful to the
                # database it captured (the point of a training/forensic archive) and
                # leaves redaction to the consumer. It also means every export is
                # credential-bearing: handle it as a secret, and redact before sharing.
                # The place to change that is the per-table SELECT below: project the
                # columns, or subtract the credential keys from row_to_json.
                'credentials': 'included verbatim in raw/*.jsonl and raw/postgres.dump '
                               '(llm_profiles.api_key, oauth_grants tokens, task_credentials, '
                               'notify_channels config); redact before sharing',
                'limits': ['guest-root can tamper with guest-side captures',
                           'packet rotation overwrites old segments; inspect session manifest',
                           'TLS packet payloads are encrypted; application proxy records inspectable HTTP',
                           'reasoning exists only when explicitly exposed by the provider']}
    psql = ['psql', '-h', '/run/postgresql', '-U', 'postgres', '-d', 'm1nervac0nsole', '-X', '-qAt', '-v', 'ON_ERROR_STOP=1']
    tables = guest(*psql, '-c', "SELECT tablename FROM pg_tables WHERE schemaname='public' ORDER BY tablename",
                   capture_output=True, text=True).stdout.splitlines()
    if not tables or any(not re.fullmatch('[a-z_][a-z_0-9]*', t) for t in tables):
        raise RuntimeError('Unexpected PostgreSQL table list')
    sql = 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;\n'
    sql += '\n'.join(f"SELECT json_build_object('table','{t}','row',row_to_json(t)) FROM public.\"{t}\" t;" for t in tables)
    sql += '\nCOMMIT;'
    handles = {table: (raw / (table + '.jsonl')).open('w') for table in tables}
    counts = dict.fromkeys(tables, 0)
    try:
        with (raw / 'table-export.stderr').open('w') as errors:
            proc = subprocess.Popen([str(MSB), 'exec', '--no-stdin', NAME, '--', *psql, '-c', sql],
                                    stdout=subprocess.PIPE, stderr=errors, text=True)
            try:
                for line in proc.stdout:
                    record = json.loads(line)
                    table = record['table']
                    handles[table].write(json.dumps(record['row'], ensure_ascii=False) + '\n')
                    counts[table] += 1
            except BaseException:
                proc.kill()
                proc.wait()
                raise
            finally:
                proc.stdout.close()
            if proc.wait():
                raise RuntimeError(f'Table export failed; see {raw}/table-export.stderr')
    finally:
        for handle in handles.values():
            handle.close()
    with (raw / 'postgres.dump').open('wb') as dump:
        guest('pg_dump', '-h', '/run/postgresql', '-U', 'postgres', '-d', 'm1nervac0nsole', '-Fc', stdout=dump)
    guest('sync')
    with (raw / 'capture-export.stderr').open('w') as errors:
        exporter = '/dist/guest-export.py' if guest_file('/dist/guest-export.py') else '/opt/agentlab/guest-export.py'
        proc = subprocess.Popen([str(MSB), 'exec', '--no-stdin', NAME, '--',
                                 'python3', exporter],
                                stdout=subprocess.PIPE, stderr=errors)
        try:
            extract_capture_archive(proc.stdout, raw)
        except BaseException:
            proc.kill()
            proc.wait()
            raise
        finally:
            proc.stdout.close()
        if proc.wait():
            raise RuntimeError(f'Guest file snapshot failed; see {raw}/capture-export.stderr')
    logs = ROOT / 'microsandbox/sandboxes' / NAME / 'logs'
    if logs.exists():
        shutil.copytree(logs, raw / 'runtime-logs', symlinks=True)
    if (ROOT / 'host-events.jsonl').exists():
        shutil.copyfile(ROOT / 'host-events.jsonl', raw / 'host-events.jsonl')
    with (raw / 'sandbox.json').open('w') as stream:
        msb('inspect', NAME, '--format', 'json', stdout=stream)
    shutil.copyfile(ROOT / 'deployment/provenance.json', raw / 'provenance.json')
    proxy_network = PROXY_STATE / 'network'
    if proxy_network.exists():
        target = raw / 'provider-proxy-network'
        target.mkdir(mode=0o700)
        for path in sorted(proxy_network.glob('proxy.*')):
            if path.is_file() and not path.is_symlink():
                shutil.copyfile(path, target / path.name)
        manifest['provider_proxy_network'] = {
            'source': 'host provider-proxy process strace',
            'scope': 'host proxy process/file/network syscalls, including upstream provider connections',
            'limit': 'decoded arguments limited to 256 bytes; TLS payloads remain encrypted; plaintext socket buffers can contain the guest capability token and OAuth callback material',
            'consistency': 'online file copy; credential stores and token files are never exported; raw strace is secret-bearing and private',
        }
    provider_proxy_traffic = export_provider_proxy_traffic(raw)
    if provider_proxy_traffic is not None:
        manifest['provider_proxy_traffic'] = provider_proxy_traffic
    shutil.copyfile(ROOT / 'deployment/sandbox.yaml', raw / 'sandbox.yaml')
    sys.path.insert(0, str(ROOT / 'deployment'))
    import export_traces
    manifest['training'] = export_traces.export(raw, output / 'training')
    manifest['table_rows'] = counts
    manifest['completed_at'] = now()
    hashes = {}
    for path in output.rglob('*'):
        if path.is_file() and not path.is_symlink():
            with path.open('rb') as stream:
                hashes[str(path.relative_to(output))] = hashlib.file_digest(stream, 'sha256').hexdigest()
    manifest['sha256'] = hashes
    (output / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print(json.dumps({'export': str(output), 'table_rows': counts, 'training': manifest['training']}, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    for name in ('stop', 'status', 'export', 'primary'):
        sub.add_parser(name)
    sub.add_parser('build', help='Rebuild the guest binary, skills and scripts that /dist carries')
    boot = sub.add_parser('start', help='Start the VM, optionally through an OpenVPN profile')
    boot.add_argument('--vpn', metavar='PROFILE',
                      help='OpenVPN .ovpn/.conf to bring up before capture; egress is refused if the tunnel drops')
    boot.add_argument('--state-quota-gb', metavar='GB', type=int,
                      help='/state quota in GiB (0 = none); only applies when the VM is created, see resize-state')
    grow = sub.add_parser('resize-state', help='Recreate the VM with a different /state quota (state/ is kept)')
    grow.add_argument('gb', type=int, help='new quota in GiB (0 = no quota)')
    grow.add_argument('--yes', action='store_true', help='confirm that the VM root disk is recreated')
    run = sub.add_parser('exec', help='Execute an adaptable guest command and record its output')
    run.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.action == 'start':
        start(args.vpn, args.state_quota_gb)
    elif args.action == 'build':
        build_guest_dist(force=True)
        print(json.dumps({'guest_dist': str(GUEST_DIST), 'stale': guest_dist_stale()}))
    elif args.action == 'resize-state':
        resize_state(args.gb, args.yes)
    elif args.action == 'stop':
        stop()
    elif args.action == 'status':
        msb('inspect', NAME, '--format', 'json')
        usage = shutil.disk_usage(STATE_DIR)
        print(json.dumps({'host_state_filesystem_free_gib': round(usage.free / 2**30, 1),
                          'host_state_filesystem_total_gib': round(usage.total / 2**30, 1)}))
        print(json.dumps(api('/api/settings', token=login()), indent=2))
    elif args.action == 'exec':
        return execute(args.command)
    elif args.action == 'export':
        export()
    elif args.action == 'primary':
        primary()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f'agentlab: {exc}', file=sys.stderr)
        sys.exit(1)
