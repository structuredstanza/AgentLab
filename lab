            if not path.exists():
                break
            time.sleep(0.25)
        else:
            raise RuntimeError('Supervisor did not shut down cleanly; VM left running')
""")
    # The staged OpenVPN profile is a credential; it must not outlive the run that
    # asked for it, or a later start would tunnel through someone else's endpoint.
    stage_vpn(None)
    msb('stop', NAME)


HOST_EVENTS = 'host-events.jsonl'
NATIVE_SSE = 'native-sse.ndjson'
# Streams that a writer holds open are never pruned; only rotated segments are.
ACTIVE_STREAMS = {HOST_EVENTS, NATIVE_SSE}
# The only files `prune` may delete: rotated segments of the two append-only streams.
PRUNABLE = ('host-events-*.jsonl', 'proxy-state/captures/native-sse-*.ndjson')
# Bounded segments keep an append-only stream from growing without limit and let
# an export copy it and `prune` delete what it captured without racing the writer.
STREAM_SEGMENT_BYTES = 64 << 20


def stream_segment(path):
    """Reserve a unique immutable segment name beside an append-only stream."""
    for attempt in range(1000):
        suffix = '' if attempt == 0 else f'-{attempt}'
        target = path.with_name(f'{path.stem}-{time.time_ns()}{suffix}{path.suffix}')
        try:
            os.close(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
        except FileExistsError:
            continue
        return target
    raise RuntimeError(f'Could not reserve a segment name beside {path}')


def rotate_stream(path, limit=STREAM_SEGMENT_BYTES):
    """Move a full append-only stream to an immutable segment; return the segment.

    Rotation happens before the writer opens the file, so a segment is never
    appended to once it exists and `lab prune` can delete it safely. Rotated
    segments survive a restart; nothing is deleted here.
    """
    if path.is_symlink():
        raise RuntimeError(f'Refusing symlinked event stream: {path}')
    try:
        if path.stat().st_size < limit:
            return None
    except FileNotFoundError:
        return None
    target = stream_segment(path)
    try:
        path.replace(target)
    except BaseException:
        target.unlink(missing_ok=True)
        raise
    return target


def execute(command):
    if command and command[0] == '--':
        command = command[1:]
    if not command:
        raise ValueError('exec requires a command after --')
    log = ROOT / HOST_EVENTS
    rotate_stream(log)
    command_id = uuid.uuid4().hex
    with log.open('ab', buffering=0) as events:
        def event(kind, **data):
            line = json.dumps({'timestamp': now(), 'command_id': command_id, 'kind': kind, **data}) + '\n'
            os.write(events.fileno(), line.encode())
        event('command_start', argv=command)
        proc = subprocess.Popen([str(MSB), 'exec', '--no-stdin', NAME, '--', *command],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        with selectors.DefaultSelector() as streams:
            streams.register(proc.stdout, selectors.EVENT_READ, ('stdout', sys.stdout.buffer))
            streams.register(proc.stderr, selectors.EVENT_READ, ('stderr', sys.stderr.buffer))
            while streams.get_map():
                for key, _ in streams.select():
                    chunk = os.read(key.fd, 65536)
                    if not chunk:
                        streams.unregister(key.fileobj)
                        key.fileobj.close()
                        continue
                    kind, target = key.data
                    event(kind, data_base64=base64.b64encode(chunk).decode())
                    try:
                        target.write(chunk)
                        target.flush()
                    except BrokenPipeError:
                        pass  # Continue draining and recording the command when its display pipe closes.
        code = proc.wait()
        event('command_exit', argv=command, exit_code=code)
    return code


def extract_capture_archive(stream, destination):
    def regular_files_only(member, path):
        if not member.isfile() and not member.isdir():
            raise ValueError(f'Non-regular guest archive member rejected: {member.name}')
        filtered = tarfile.data_filter(member, path)
        filtered.mode = 0o700 if filtered.isdir() else 0o600
        return filtered
    with tarfile.open(fileobj=stream, mode='r|') as archive:
        archive.extractall(destination, filter=regular_files_only)


def copy_artifact(source, target):
    """Copy one file into an export with private modes; return its sha256."""
    created = False
    try:
        with source.open('rb') as source_stream, target.open('xb') as target_stream:
            created = True
            shutil.copyfileobj(source_stream, target_stream)
        target.chmod(0o600)
        with target.open('rb') as stream:
            return hashlib.file_digest(stream, 'sha256').hexdigest()
    except BaseException:
        if created:
            target.unlink(missing_ok=True)
        raise


def export_segments(sources, root, target_dir, raw):
    """Copy every stream segment into target_dir; return the manifest entries."""
    target_dir.mkdir(mode=0o700)
    target_dir.chmod(0o700)
    entries = []
    for source in sources:
        if source.is_symlink() or not source.is_file():
            raise RuntimeError(f'Capture stream is not a regular file: {source}')
        target = target_dir / source.name
        entries.append({'source': str(source.relative_to(root)),
                        'artifact': str(target.relative_to(raw)),
                        'sha256': copy_artifact(source, target)})
    return entries


def export_provider_proxy_traffic(raw):
    """Copy every native provider capture segment; return the manifest entry."""
    capture_dir = PROXY_STATE / 'captures'
    if PROXY_STATE.is_symlink() or capture_dir.is_symlink():
        raise RuntimeError('Refusing symlinked native provider capture')
    sources = sorted(capture_dir.glob('native-sse*.ndjson')) if capture_dir.is_dir() else []
    if not sources:
        return None
    return {
        'source': 'proxy-state/captures/native-sse*.ndjson',
        'artifact': 'raw/provider-proxy-traffic/',
        'segments': export_segments(sources, ROOT, raw / 'provider-proxy-traffic', raw),
        'format': 'NDJSON privacy.Record; Body is base64-encoded',
        'correlation_fields': ['Direction', 'Provider', 'Model', 'Profile', 'SessionID'],
        'scope': 'Native provider inference HTTP request/response bodies before core response translation or aggregation; not a PCAP or full wire capture',
        'privacy': 'Raw provider HTTP bodies and path/content metadata may be sensitive; SessionID is client-supplied opaque data; keep private',
    }


def export_host_events(raw):
    """Copy every recorded host event segment; return the manifest entry."""
    sources = sorted(ROOT.glob('host-events*.jsonl'))
    if not sources:
        return None
    return {
        'source': 'host-events*.jsonl',
        'artifact': 'raw/host-events/',
        'segments': export_segments(sources, ROOT, raw / 'host-events', raw),
    }


def prunable_segments(entries):
    """The rotated segments an export captured; the active streams stay put."""
    return [{'source': segment['source'], 'sha256': segment['sha256']}
            for entry in entries if entry is not None
            for segment in entry['segments']
            if Path(segment['source']).name not in ACTIVE_STREAMS]


def export():
    """Write one complete export, or leave no directory behind at all.

    A half-written export is not evidence of anything and a later `prune` must
    never be pointed at one, so a failure removes the whole directory rather
    than resuming from it.
    """
    export_id = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
    output = ROOT / 'exports' / export_id
    try:
        output.mkdir(parents=True, mode=0o700)
    except FileExistsError:
        raise RuntimeError(f'Export already exists: {output}') from None
    try:
        summary = write_export(output)
    except BaseException:
        shutil.rmtree(output, ignore_errors=True)
        raise
    print(json.dumps(summary, indent=2))


def write_export(output):
    """Write every artifact and the manifest below output; return the summary."""
    raw = output / 'raw'
    raw.mkdir(mode=0o700)
    manifest = {'started_at': now(), 'sandbox': NAME, 'model_data': 'genuine records only',
                'consistency': 'transactional PostgreSQL rows; separate pg_dump snapshot; online filesystem copy',
                'privacy': 'raw artifacts may contain credentials, task content and personal data',
                # Deliberate: the raw table dump is verbatim, so credential columns
                # travel with it -- llm_profiles.api_key, llm_profiles.api_key_hint,
                # oauth_grants.access_token/refresh_token, task_credentials.password
                # and notify_channels.config. This keeps an export faithful to the
                # database it captured (the point of a training/forensic archive) and
                # leaves redaction to the consumer. It also means every export is
                # credential-bearing: handle it as a secret, and redact before sharing.
                # The place to change that is the per-table SELECT below: project the
                # columns, or subtract the credential keys from row_to_json.
                'credentials': 'included verbatim in raw/*.jsonl and raw/postgres.dump '
                               '(llm_profiles.api_key, oauth_grants tokens, task_credentials, '
                               'notify_channels config); redact before sharing',
                'limits': ['guest-root can tamper with guest-side captures',
                           'packet rotation overwrites old segments; inspect session manifest',
                           'TLS packet payloads are encrypted; application proxy records inspectable HTTP',
                           'host event and native provider streams rotate into segments; only '
                           './lab prune <export> deletes the segments a verified export captured',
                           'reasoning exists only when explicitly exposed by the provider']}
    psql = ['psql', '-h', '/run/postgresql', '-U', 'postgres', '-d', 'm1nervac0nsole', '-X', '-qAt', '-v', 'ON_ERROR_STOP=1']
    tables = guest(*psql, '-c', "SELECT tablename FROM pg_tables WHERE schemaname='public' ORDER BY tablename",
                   capture_output=True, text=True).stdout.splitlines()
    if not tables or any(not re.fullmatch('[a-z_][a-z_0-9]*', t) for t in tables):
        raise RuntimeError('Unexpected PostgreSQL table list')
    sql = 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;\n'
    sql += '\n'.join(f"SELECT json_build_object('table','{t}','row',row_to_json(t)) FROM public.\"{t}\" t;" for t in tables)
    sql += '\nCOMMIT;'
    handles = {table: (raw / (table + '.jsonl')).open('w', encoding='utf-8') for table in tables}
    counts = dict.fromkeys(tables, 0)
    try:
        with (raw / 'table-export.stderr').open('w', encoding='utf-8') as errors:
            proc = subprocess.Popen([str(MSB), 'exec', '--no-stdin', NAME, '--', *psql, '-c', sql],
                                    stdout=subprocess.PIPE, stderr=errors, text=True)
            try:
                for line in proc.stdout:
                    record = json.loads(line)
                    table = record['table']
                    handles[table].write(json.dumps(record['row'], ensure_ascii=False) + '\n')
                    counts[table] += 1
            except BaseException:
                proc.kill()
                proc.wait()
                raise
            finally:
                proc.stdout.close()
            if proc.wait():
                raise RuntimeError(f'Table export failed; see {raw}/table-export.stderr')
    finally:
        for handle in handles.values():
            handle.close()
    with (raw / 'postgres.dump').open('wb') as dump:
        guest('pg_dump', '-h', '/run/postgresql', '-U', 'postgres', '-d', 'm1nervac0nsole', '-Fc', stdout=dump)
    guest('sync')
    with (raw / 'capture-export.stderr').open('w', encoding='utf-8') as errors:
        exporter = '/dist/guest-export.py' if guest_file('/dist/guest-export.py') else '/opt/agentlab/guest-export.py'
        proc = subprocess.Popen([str(MSB), 'exec', '--no-stdin', NAME, '--',
                                 'python3', exporter],
                                stdout=subprocess.PIPE, stderr=errors)
        try:
            extract_capture_archive(proc.stdout, raw)
        except BaseException:
            proc.kill()
            proc.wait()
            raise
        finally:
            proc.stdout.close()
        if proc.wait():
            raise RuntimeError(f'Guest file snapshot failed; see {raw}/capture-export.stderr')
    logs = ROOT / 'microsandbox/sandboxes' / NAME / 'logs'
    if logs.exists():
        shutil.copytree(logs, raw / 'runtime-logs', symlinks=True)
    host_events = export_host_events(raw)
    if host_events is not None:
        manifest['host_events'] = host_events
    with (raw / 'sandbox.json').open('w', encoding='utf-8') as stream:
        msb('inspect', NAME, '--format', 'json', stdout=stream)
    shutil.copyfile(ROOT / 'deployment/provenance.json', raw / 'provenance.json')
    proxy_network = PROXY_STATE / 'network'
    if proxy_network.exists():
        target = raw / 'provider-proxy-network'
        target.mkdir(mode=0o700)
        for path in sorted(proxy_network.glob('proxy.*')):
            if path.is_file() and not path.is_symlink():
                shutil.copyfile(path, target / path.name)
        manifest['provider_proxy_network'] = {
            'source': 'host provider-proxy process strace',
            'scope': 'host proxy process/file/network syscalls, including upstream provider connections',
            'limit': 'decoded arguments limited to 256 bytes; TLS payloads remain encrypted; plaintext socket buffers can contain the guest capability token and OAuth callback material',
            'consistency': 'online file copy; credential stores and token files are never exported; raw strace is secret-bearing and private',
        }
    provider_proxy_traffic = export_provider_proxy_traffic(raw)
    if provider_proxy_traffic is not None:
        manifest['provider_proxy_traffic'] = provider_proxy_traffic
    # Only immutable segments are prunable: the active stream is still being
    # written, and `prune` re-checks each hash before it deletes anything.
    manifest['prunable'] = prunable_segments((host_events, provider_proxy_traffic))
    shutil.copyfile(ROOT / 'deployment/sandbox.yaml', raw / 'sandbox.yaml')
    sys.path.insert(0, str(ROOT / 'deployment'))
    import export_traces
    manifest['training'] = export_traces.export(raw, output / 'training')
    manifest['table_rows'] = counts
    manifest['completed_at'] = now()
    hashes = {}
    for path in output.rglob('*'):
        if path.is_file() and not path.is_symlink():
            with path.open('rb') as stream:
                hashes[str(path.relative_to(output))] = hashlib.file_digest(stream, 'sha256').hexdigest()
    manifest['sha256'] = hashes
    (output / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n', encoding='utf-8')
    return {'export': str(output), 'table_rows': counts, 'training': manifest['training']}


def verify_export(output):
    """Load an export manifest and verify every artifact it lists.

    Refuses anything a deletion could not be undone from: a missing or unreadable
    manifest, a listed artifact that is gone, or one whose bytes changed.
    """
    path = output / 'manifest.json'
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f'Export has no manifest: {output}')
    try:
        manifest = json.loads(path.read_text(encoding='utf-8'))
    except (OSError, ValueError) as exc:
        raise RuntimeError(f'Export manifest is unreadable: {exc}') from None
    if not isinstance(manifest, dict):
        raise RuntimeError(f'Export manifest is not an object: {path}')
    hashes = manifest.get('sha256')
    if not isinstance(hashes, dict) or not hashes:
        raise RuntimeError(f'Export manifest lists no artifact hashes: {path}')
    for relative, expected in hashes.items():
        if not isinstance(relative, str) or Path(relative).is_absolute() or '..' in Path(relative).parts:
            raise RuntimeError(f'Export manifest lists an unsafe path: {relative!r}')
        artifact = output / relative
        if artifact.is_symlink() or not artifact.is_file():
            raise RuntimeError(f'Export artifact is missing: {relative}')
        with artifact.open('rb') as stream:
            if hashlib.file_digest(stream, 'sha256').hexdigest() != expected:
                raise RuntimeError(f'Export artifact does not match its manifest: {relative}')
    return manifest


def prune(export_id, dry_run=False):
    """Delete the immutable stream segments one verified export captured.

    This is the only deletion path; nothing prunes automatically. A segment goes
    only when the export's manifest verifies and the file still holds exactly the
    bytes that export copied, so a stream that grew afterwards keeps its data. Only
    rotated segments are eligible: the active streams are still being written.
    """
    if not re.fullmatch(r'[0-9A-Za-z][0-9A-Za-z._-]*', export_id):
        raise RuntimeError(f'Not an export id: {export_id!r}')
    output = ROOT / 'exports' / export_id
    if output.is_symlink() or not output.is_dir():
        raise RuntimeError(f'Export not found: {output}')
    manifest = verify_export(output)
    targets = []
    for entry in manifest.get('prunable') or []:
        source = entry.get('source') if isinstance(entry, dict) else None
        if not isinstance(source, str) or not any(Path(source).match(p) for p in PRUNABLE):
            raise RuntimeError(f'Export manifest lists an unprunable source: {source!r}')
        path = ROOT / source
        if path.is_symlink() or not path.is_file():
            continue  # already pruned, or never a regular file
        with path.open('rb') as stream:
            if hashlib.file_digest(stream, 'sha256').hexdigest() != entry.get('sha256'):
                continue  # the stream grew after the export; this file is not fully captured
        targets.append(path)
    if not dry_run:
        for path in targets:
            path.unlink()
    print(json.dumps({'export': str(output), 'dry_run': dry_run,
                      'delete': [str(path.relative_to(ROOT)) for path in targets]}, indent=2))
    return targets


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    for name in ('stop', 'status', 'export', 'primary'):
        sub.add_parser(name)
    sub.add_parser('build', help='Rebuild the guest binary, skills and scripts that /dist carries')
    image = sub.add_parser('image-build',
                           help='Build the image tag sandbox.yaml names as <tag>-candidate; no VM change')
    image.add_argument('--replace', action='store_true',
                       help='after the candidate passes, keep the current image as <tag>-prev-<id12> '
                            'and move <tag> onto the candidate')
    boot = sub.add_parser('start', help='Start the VM, optionally through an OpenVPN profile')
    boot.add_argument('--vpn', metavar='PROFILE',
                      help='OpenVPN .ovpn/.conf to bring up before capture; egress is refused if the tunnel drops')
    boot.add_argument('--state-quota-gb', metavar='GB', type=int,
                      help='/state quota in GiB (0 = none); only applies when the VM is created, see resize-state')
    grow = sub.add_parser('resize-state', help='Recreate the VM with a different /state quota (state/ is kept)')
    grow.add_argument('gb', type=int, help='new quota in GiB (0 = no quota)')
    grow.add_argument('--yes', action='store_true', help='confirm that the VM root disk is recreated')
    run = sub.add_parser('exec', help='Execute an adaptable guest command and record its output')
    run.add_argument('command', nargs=argparse.REMAINDER)
    cut = sub.add_parser('prune', help='Delete the stream segments a verified export captured')
    cut.add_argument('export_id', help='export directory name under exports/')
    cut.add_argument('--dry-run', action='store_true',
                     help='list what would be deleted and change nothing')
    args = parser.parse_args()
    if args.action == 'start':
        start(args.vpn, args.state_quota_gb)
    elif args.action == 'build':
        build_guest_dist(force=True)
        print(json.dumps({'guest_dist': str(GUEST_DIST), 'stale': guest_dist_stale()}))
    elif args.action == 'image-build':
        image_build(args.replace)
    elif args.action == 'resize-state':
        resize_state(args.gb, args.yes)
    elif args.action == 'stop':
        stop()
    elif args.action == 'status':
        msb('inspect', NAME, '--format', 'json')
        usage = shutil.disk_usage(STATE_DIR)
        print(json.dumps({'host_state_filesystem_free_gib': round(usage.free / 2**30, 1),
                          'host_state_filesystem_total_gib': round(usage.total / 2**30, 1)}))
        # A stopped VM is a normal state, not a failure: report it and exit 0.
        try:
            print(json.dumps(api('/api/settings', token=login()), indent=2))
        except OSError as exc:
            print(f'console not reachable: {exc}', file=sys.stderr)
    elif args.action == 'exec':
        return execute(args.command)
    elif args.action == 'export':
        export()
    elif args.action == 'prune':
        prune(args.export_id, args.dry_run)
    elif args.action == 'primary':
        primary()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f'agentlab: {exc}', file=sys.stderr)
        sys.exit(1)
